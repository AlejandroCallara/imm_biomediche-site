3f} s.\")\n\ntime = np.cumsum(time)  # N.B.: ho così generato l'asse dei tempi per le curve TAC\n\n# mostrare le curve TAC:\nplt.figure()\n....\n\n# costruzione rappresentazione grafica:  \nant = tissueROI\nlv = bloodROI\nx = np.zeros(len(time) - 1)\ny = np.zeros(len(time) - 1)\n....\n\n# fitting con una retta:\n    \n....\n\n# mostrare il grafico risultante\n# N.B.: per avere il risultato analogo a quello dato, non considerare il \n# primo punto, perchè ha un comportamento anomalo'  \nplt.figure()\n....\n\nplt.show()","position":{"start":{"line":22,"column":1},"end":{"line":81,"column":1}},"key":"xUSVwX4RAF"},{"type":"heading","depth":3,"position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"children":[{"type":"inlineCode","value":"VediImmagini.py","position":{"start":{"line":84,"column":1},"end":{"line":84,"column":1}},"key":"olPvjPjsDh"}],"identifier":"vediimmagini-py","label":"VediImmagini.py","html_id":"vediimmagini-py","implicit":true,"key":"toky7fmS26"},{"type":"code","lang":"python","value":"# -*- coding: utf-8 -*-\n\"\"\"\nCreated on Thu Apr 10 12:55:03 2025\n\n@author: mfilo\n\"\"\"\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport pydicom\nimport os\n\n# Visualizzazione immagini di dati PET [15O]H2O (per analisi di flusso)\n\n\n# Fetta n. 15 per 20 time-steps\nnome_file = 'H2O_Slice15_time'\ntime = np.zeros(20)  # vettore tempo\nplt.figure()\n\nfor n_imm in range(20):\n    nome_file_completo = f\"{nome_file}{n_imm}.dcm\"\n    try:\n        ds = pydicom.dcmread(nome_file_completo)\n        imm = ds.pixel_array.astype(float)  # Converti in float per le operazioni\n        inf = ds\n\n        time[n_imm] = (inf.ActualFrameDuration / 1000)  # durata di acquisizione in secondi\n        print(f\"imm N. {n_imm}, durata acq: {time[n_imm]:.3f} s.\")\n\n        # Rescaling dei dati (per avere valori in Bq/ml)\n        imm = (imm * inf.RescaleSlope + inf.RescaleIntercept)\n        # N.B. senza il rescaling, i valori vanno da 0 a 32767: non sono\n        # valori assoluti!!!\n\n        plt.imshow(imm, cmap='gray')\n        plt.axis('off')\n        plt.colorbar()\n        plt.pause(0.3)\n\n    except FileNotFoundError:\n        print(f\"Errore: File non trovato - {nome_file_completo}\")\n        break  # Interrompi il loop se un file non viene trovato\n\ntime = np.cumsum(time)  # N.B.: ho così generato l'asse dei tempi per le curve TAC\n\nprint(\"\\nVettore dei tempi cumulativi (in s.):\")\nprint(time)\n\nplt.show()","position":{"start":{"line":86,"column":1},"end":{"line":137,"column":1}},"key":"YFg96qbwBm"},{"type":"heading","depth":2,"position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"children":[{"type":"text","value":"Soluzione","position":{"start":{"line":140,"column":1},"end":{"line":140,"column":1}},"key":"nURhCo65iV"}],"identifier":"soluzione","label":"Soluzione","html_id":"soluzione","implicit":true,"key":"NbTtpEpJ74"},{"type":"image","url":"/imm_biomediche-site/build/image_z_3_1-96bf5c3e8e5de3a7b83f87cbf4c9f663.png","alt":"Risultati dal PDF originale 1","position":{"start":{"line":142,"column":1},"end":{"line":142,"column":1}},"key":"G3aHuc3uWu","urlSource":"./images/image_z_3_1.png"},{"type":"image","url":"/imm_biomediche-site/build/z_3_1_p02-59196130990a3e5cdf0cb31dd11bc1bd.png","alt":"Risultati dal PDF originale 2","position":{"start":{"line":144,"column":1},"end":{"line":144,"column":1}},"key":"k9ya1Z8n5d","urlSource":"./images/santarelli/z_3_1_p02.png"}],"key":"QgwRiJbJLy"}],"key":"EPc1Zr31bZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Capitolo 3: Immagini In Medicina Nucleare","url":"/c3-immagini-in-medicina-nucleare","group":"Capitolo 3"},"next":{"title":"Esercitazione 3.2: Traccianti per misure di metabolismo [18F]FDG-PET","url":"/z-3-2-esercitazione","group":"Capitolo 3"}}},"domain":"http://localhost:3000"}