ding: utf-8 -*-\n\"\"\"\nEsempio di fitting tra dati rumorosi e  modello non lineare\n\n\"\"\"\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom scipy.optimize import curve_fit\n\ndef non_linear_model(t, a1, b1, a2, b2):\n    \"\"\"Esempio di modello non lineare.\"\"\"\n    return a1 * np.exp(-b1 * t) + a2 * np.exp(-b2 * t)\n\n# %%\n# utilizzo della funzione curve_fit per il fitting di modelli non lineari\n# a dati misurati\n\nt = np.linspace(0, 2, 50)\np = [3, 10.5, 8, 1.4]\ny_true = non_linear_model(t, *p)\nnp.random.seed(1)\nydata = y_true + 0.3 * np.random.randn(len(y_true))\n\nplt.figure()\nplt.plot(t, y_true, 'r-', t, ydata, 'b*')\nplt.legend(['curva simulata', 'misura'])\n# plt.show()\n\n\nx0 = [1, 1, 1, 0]\n\n# We run the solver and plot the resulting fit.\np_est, pcov = curve_fit(non_linear_model, t, ydata, p0=x0)\ny_fit = non_linear_model(t, *p_est)\n\nplt.plot(t, y_fit, '-k')\nplt.legend(['curva simulata', 'misura', 'curva stimata'])\nplt.show()\n\n# %%\n# aggiunta di opzioni (bounds)\nlb = [0, 0, 0, 0]  \nub = [5, 15, 10, 3]\n\nplt.figure()\nplt.plot(t, y_true, 'r-', t, ydata, 'b*')\nplt.legend(['curva simulata', 'misura'])\n\np1_est, pcov1 = curve_fit(non_linear_model, t, ydata, p0=x0, bounds=(lb, ub))\ny_fit1 = non_linear_model(t, *p1_est)\n\nplt.plot(t, y_fit1, '-k')\nplt.legend(['curva simulata', 'misura', 'curva stimata'])\nplt.show()\n\n# %%\nprint(f\"Valori dei parametri: {p}\")\nprint(\" PRIMO FITTING: \")\nprint(f\"  Parametri: {p_est}, ResNorm: {np.sum((ydata - non_linear_model(t, *p_est))**2)}\")\nprint(\" SECONDO FITTING: \")\nprint(f\"  Parametri: {p1_est}, ResNorm: {np.sum((ydata - non_linear_model(t, *p1_est))**2)}\")","position":{"start":{"line":38,"column":1},"end":{"line":102,"column":1}},"key":"Se2LxKJwsN"},{"type":"heading","depth":2,"position":{"start":{"line":105,"column":1},"end":{"line":105,"column":1}},"children":[{"type":"text","value":"Diapositive dal PDF originale","position":{"start":{"line":105,"column":1},"end":{